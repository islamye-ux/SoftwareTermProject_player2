<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Swtermproject" parent="Theme.Material3.Light.NoActionBar">

        <!-- ── Colors ─────────────────────────────────────────── -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryLight</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOutline">@color/colorBorder</item>
        <item name="colorError">@color/colorError</item>

        <!-- ── Shape — Apple-style rounded corners ────────────── -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.KoLi.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.KoLi.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.KoLi.Large</item>
        <!-- ── Typography — Inter font ────────────────────────── -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

        <!-- ── Elevation — subtle shadows ─────────────────────── -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- ── Status bar ──────────────────────────────────────── -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>

    </style>

    <style name="Theme.Swtermproject" parent="Base.Theme.Swtermproject" />

    <!-- ── Shape Appearances ──────────────────────────────────── -->
    <style name="ShapeAppearance.KoLi.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.KoLi.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.KoLi.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ── Splash — clean white Apple style ───────────────────── -->
    <style name="Theme.Swtermproject.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- ── Card style ──────────────────────────────────────────── -->
    <style name="KoLi.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <!-- ── Button style ────────────────────────────────────────── -->
    <style name="KoLi.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ── Toolbar ─────────────────────────────────────────────── -->
    <style name="KoLi.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorSurface</item>
        <item name="titleTextColor">@color/colorTextPrimary</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>
