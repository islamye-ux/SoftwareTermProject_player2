# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for source files
*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.pro   text eol=lf

# Keep CRLF for Windows-specific scripts
*.bat   text eol=crlf

# Binary files
*.png   binary
*.jpg   binary
*.webp  binary
*.jar   binary
*.keystore binary
